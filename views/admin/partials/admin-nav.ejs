<header class="admin-header">
  <div class="container nav-inner">
    <a class="brand" href="/admin"><span class="brand-name">LEVEL <em>AUTO</em></span> <span class="admin-tag">panel</span></a>
    <nav class="main-nav">
      <a href="/admin" class="<%= tab === 'cars' ? 'active' : '' %>">Ogłoszenia</a>
      <a href="/admin/auta/nowe" class="<%= tab === 'new' ? 'active' : '' %>">Dodaj auto</a>
      <a href="/admin/auta/nowe?kategoria=gotowe" class="<%= tab === 'new-ready' ? 'active' : '' %>">Dodaj gotowe auto</a>
      <a href="/admin/import" class="<%= tab === 'import' ? 'active' : '' %>">Import z Otomoto</a>
      <a href="/admin/wiadomosci" class="<%= tab === 'messages' ? 'active' : '' %>">Wiadomości</a>
      <a href="/admin/chat" class="<%= tab === 'chat' ? 'active' : '' %>">Live chat</a>
      <a href="/" target="_blank">Podgląd strony ↗</a>
    </nav>
    <form method="POST" action="/admin/logout" class="logout-form">
      <span class="admin-user"><%= adminName %></span>
      <button type="submit" class="btn btn-outline btn-sm">Wyloguj</button>
    </form>
  </div>
</header>
