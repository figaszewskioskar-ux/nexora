<div class="topbar">
  <div class="container topbar-inner">
    <div class="topbar-contact">
      <a href="tel:<%= contactPhone.replace(/\s/g,'') %>">☎ <%= contactPhone %></a>
      <a href="mailto:<%= contactEmail %>">✉ <%= contactEmail %></a>
    </div>
    <span class="topbar-hours">pon–pt 9:00–18:00 · sob 10:00–14:00</span>
  </div>
</div>
<header class="site-header">
  <div class="container nav-inner">
    <a class="brand" href="/">
      <img src="/img/logo.svg" alt="Level Auto" class="brand-logo">
      <span class="brand-name">LEVEL <em>AUTO</em></span>
    </a>
    <nav class="main-nav" id="mainNav">
      <a href="/" class="<%= page === 'home' ? 'active' : '' %>">Strona główna</a>
      <a href="/auta" class="<%= page === 'cars' ? 'active' : '' %>">Auta na sprzedaż</a>
      <a href="/gotowe" class="<%= page === 'ready' ? 'active' : '' %>">Auta od ręki</a>
      <a href="/#uslugi">Jak działamy</a>
      <a href="/#o-nas">O nas</a>
      <a href="/#kontakt" class="nav-cta">Kontakt</a>
    </nav>
    <button class="nav-toggle" aria-label="Menu" onclick="document.getElementById('mainNav').classList.toggle('open')">☰</button>
  </div>
</header>
