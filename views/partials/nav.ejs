<div id="preloader" aria-hidden="true">
  <div class="preloader-inner">
    <img src="/img/logo-full.png" alt="" class="preloader-logo">
    <div class="preloader-bar"><span></span></div>
  </div>
</div>
<script>
  (function () {
    var pre = document.getElementById('preloader');
    var hide = function () { pre.classList.add('done'); };
    if (document.readyState === 'complete') setTimeout(hide, 350);
    else window.addEventListener('load', function () { setTimeout(hide, 350); });
    setTimeout(hide, 2600); // bezpiecznik — nigdy nie blokuj strony
  })();
</script>

<div class="topbar">
  <div class="container topbar-inner">
    <div class="topbar-contact">
      <a href="tel:<%= contactPhone.replace(/\s/g,'') %>">
        <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3 19.5 19.5 0 0 1-6-6 19.8 19.8 0 0 1-3-8.7A2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 2 .7 2.8a2 2 0 0 1-.4 2.1L8.1 9.9a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.9.5 2.8.7a2 2 0 0 1 1.7 2z"/></svg>
        <%= contactPhone %>
      </a>
      <a href="mailto:<%= contactEmail %>">
        <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-10 6L2 7"/></svg>
        <%= contactEmail %>
      </a>
    </div>
    <span class="topbar-hours">pon–pt 9:00–18:00 · sob 10:00–14:00</span>
  </div>
</div>
<header class="site-header">
  <div class="container nav-inner">
    <a class="brand" href="/">
      <img src="/img/logo-full.png" alt="Level Auto" class="brand-wordmark">
      <span class="brand-tagline">Import aut z USA i Kanady</span>
    </a>
    <nav class="main-nav" id="mainNav">
      <a href="/" class="<%= page === 'home' ? 'active' : '' %>">Strona główna</a>
      <a href="/gotowe" class="<%= page === 'ready' ? 'active' : '' %>">Auta od ręki</a>
      <a href="/w-drodze" class="<%= page === 'transit' ? 'active' : '' %>">W drodze do Polski</a>
      <a href="/#uslugi">Jak działamy</a>
      <a href="/#kontakt" class="nav-cta">Kontakt</a>
    </nav>
    <button class="nav-toggle" aria-label="Menu" onclick="document.getElementById('mainNav').classList.toggle('open')">☰</button>
  </div>
</header>
