<div id="chatWidget" class="chat-widget">
  <button id="chatToggle" class="chat-toggle" aria-label="Otwórz czat">
    <svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M21 11.5a8.38 8.38 0 0 1-8.5 8.5 8.5 8.5 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 8.5-8.5 8.38 8.38 0 0 1 8.5 8.5z"/></svg>
    <span class="chat-badge" id="chatBadge" hidden></span>
  </button>
  <div class="chat-panel" id="chatPanel" hidden>
    <div class="chat-header">
      <div>
        <strong>Level Auto — live chat</strong>
        <small>Zwykle odpowiadamy w kilka minut</small>
      </div>
      <button id="chatClose" aria-label="Zamknij">✕</button>
    </div>

    <form class="chat-intro" id="chatIntroForm">
      <p>Zostaw swoje dane, żebyśmy mogli wrócić do Ciebie z odpowiedzią — również e-mailem, gdy będziesz offline.</p>
      <div class="form-note err" id="chatIntroError" hidden></div>
      <label>Imię i nazwisko *<input type="text" id="chatName" required maxlength="80" autocomplete="name"></label>
      <label>E-mail *<input type="email" id="chatEmail" required maxlength="160" autocomplete="email"></label>
      <label>Treść wiadomości *<textarea id="chatFirstMessage" rows="3" required maxlength="2000" placeholder="W czym możemy pomóc?"></textarea></label>
      <button type="submit" class="btn btn-primary">Rozpocznij rozmowę</button>
    </form>

    <div class="chat-messages" id="chatMessages" hidden></div>
    <form class="chat-input" id="chatForm" hidden>
      <input type="text" id="chatText" placeholder="Napisz wiadomość..." autocomplete="off" maxlength="2000">
      <button type="submit">Wyślij</button>
    </form>
  </div>
</div>
<script src="/socket.io/socket.io.js"></script>
<script src="/js/chat.js"></script>
